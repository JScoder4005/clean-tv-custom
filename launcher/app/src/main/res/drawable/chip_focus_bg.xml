<?xml version="1.0" encoding="utf-8"?>
<!-- A soft highlight for a focusable header chip (the weather chip): nothing when unfocused, a faint
     rounded fill when focused, so D-pad users can tell it's reachable without a full pill outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
