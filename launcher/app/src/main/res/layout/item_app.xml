<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@string/font_body"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#F2FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.02" />

    <!-- show_taglines: a short line under the name, from app_taglines. Gone by default so a tile with no
         tagline (the common case) costs nothing and the dock row's height is unaffected. -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="180dp"
        android:layout_height="16dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="130dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@string/font_body"
        android:visibility="gone" />
</FrameLayout>
